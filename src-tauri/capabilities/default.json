{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local application window events; file access is handled by scoped Rust commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-choose-inputs",
    "allow-add-paths",
    "allow-choose-output",
    "allow-recover",
    "allow-cancel-recovery",
    "allow-clear-selection",
    "allow-open-result"
  ]
}

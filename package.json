{
  "name": "ksd-decrypt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run check && node build.mjs",
    "test": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "test:ui": "playwright test",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build:mac": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "build:windows": "tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "check": "tsc --noEmit",
    "lint:rust": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "format": "prettier --write \"src/**/*.ts\" \"tests/ui/**/*.mjs\" \"*.mjs\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/ui/**/*.mjs\" \"*.mjs\" \"*.json\""
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.5",
    "esbuild": "0.28.2",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "lucide": "1.47.0"
  }
}
